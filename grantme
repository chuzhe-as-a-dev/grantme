#!/usr/bin/env python3

import argparse
import sys
from contextlib import contextmanager
from datetime import datetime, timedelta
from getpass import getuser
from os import listdir, remove, rename
from os.path import isdir, isfile, join
from traceback import print_tb

import defs
import utils

USER = getuser()


# copied from https://github.com/zeitgitter/zeitgitterd/blob/master/zeitgitter/deltat.py
def parse_delta(delta_str):
    """
    Parse a time string e.g. '2h 13m' or '1.5d' into a timedelta object.
    Based on Peter's answer at https://stackoverflow.com/a/51916936/2445204
    and virhilo's answer at https://stackoverflow.com/a/4628148/851699
    :param delta_str: A string identifying a duration, e.g. '2h13.5m'
    :return datetime.timedelta: A datetime.timedelta object
    """
    parts = defs.DELTA_REGEX.match(delta_str)
    assert (
        parts is not None
    ), """Could not parse any time information from '{}'.
    Examples of valid strings: '8h', '2d 8h 5m 2s', '2m4.3s'""".format(
        delta_str
    )
    time_params = {
        name: float(param) for name, param in parts.groupdict().items() if param
    }
    return timedelta(**time_params)


def write_expire(path: str, expire: datetime) -> datetime:
    with open(path, "w") as f:
        written = datetime.strftime(expire, defs.EXPIRE_FORMAT)
        f.write(written)
        return datetime.strptime(written, defs.EXPIRE_FORMAT)


def get_expire(path: str) -> datetime:
    with open(path, "r") as f:
        return datetime.strptime(f.readline(), defs.EXPIRE_FORMAT)


@contextmanager
def latch(latch_file):
    try:
        with open(latch_file, "x") as f:
            f.write(USER)
            f.close()
    except:
        raise utils.RuntimeErrorWithMessageAndCode(
            defs.Message.LATCH_FAILURE_MSG, defs.Message.LATCH_FAILURE_CODE
        )

    try:
        yield True
    finally:
        remove(latch_file)


def granted():
    shares = {
        filename: get_expire(join(defs.SDIR, filename))
        for filename in listdir(defs.SDIR)
        if isfile(join(defs.SDIR, filename))
        and get_expire(join(defs.SDIR, filename)) > datetime.now()
    }
    exclusives = [
        (filename, get_expire(join(defs.XDIR, filename)))
        for filename in listdir(defs.XDIR)
        if isfile(join(defs.XDIR, filename))
        and get_expire(join(defs.XDIR, filename)) > datetime.now()
    ]

    if len(exclusives) > 1:
        raise utils.RuntimeErrorWithMessageAndCode(
            defs.Message.EXCLUSION_ERROR_MSG, defs.Message.EXCLUSION_ERROR_CODE
        )

    return shares, (None if len(exclusives) == 0 else exclusives[0])


def print_status():
    print()
    utils.show_sep_line()

    shares, exclusive = granted()

    if exclusive is not None:
        who, expire = exclusive
        if who == USER:
            who += " (YOU)"
            utils.show_granted("Exclusive", expire, highlighted_user=who)
        else:
            utils.show_granted("Exclusive", expire, others=[who])
            utils.warning(defs.Message.DO_NOT_DISTURB)
    elif len(shares) > 0:
        last_expire = max(shares.values())
        if USER in shares.keys():
            others = list(shares.keys())
            others.remove(USER)
            utils.show_granted(
                "Shared", last_expire, highlighted_user=USER + " (YOU)", others=others
            )
            utils.show_expire(shares[USER])
        else:
            utils.show_granted("Shared", last_expire, others=shares.keys())
            utils.slock_guide()
    else:
        utils.show_no_lock()

    utils.show_sep_line()


def revoke(who=USER):
    with latch(defs.LATCH_FILE):
        shares, exclusive = granted()
        if exclusive is not None and who == exclusive[0]:
            remove(join(defs.XDIR, who))
            utils.show_revoke_ok("exclusive", who)
        elif who in shares.keys():
            remove(join(defs.SDIR, who))
            utils.show_revoke_ok("shared", who)
        else:
            utils.warning(defs.Message.NOTHING_REVOKED)


# cannot grant non-current-login users, because the file created would be owned
# by the current login USER
def grant(mode, duration):
    with latch(defs.LATCH_FILE):
        shares, exclusive = granted()
        attempted_expire = datetime.now() + parse_delta(duration)

        # if already x-locked, try upgrade
        if exclusive is not None and USER == exclusive[0]:
            if mode != "exclusive":
                utils.warning(defs.Message.ATTEMP_SLOCK_WITH_XLOCK)

            old_expire = exclusive[1]
            if old_expire > attempted_expire:
                utils.warning(defs.Message.ATTEMP_SHORTER_DURATION_THAN_ALREADY_GRANTED)
                utils.show_expire(old_expire)
            else:
                pesisted = write_expire(join(defs.XDIR, USER), attempted_expire)
                utils.ok(defs.Message.PROLONG_OK)
                utils.show_expire(pesisted)

        # if already s-locked, try prolong or/and upgrade
        elif USER in shares:
            lock_path = join(defs.SDIR, USER)

            # try upgrade first
            if mode == "exclusive":
                if len(shares) == 1:
                    rename(lock_path, join(defs.XDIR, USER))
                    lock_path = join(defs.XDIR, USER)  # for later prolonging
                    utils.ok(defs.Message.UPGRADE_OK)
                else:
                    raise utils.RuntimeErrorWithMessageAndCode(
                        defs.Message.UPGRADE_FAILURE_MSG,
                        defs.Message.UPGRADE_FAILURE_CODE,
                    )

            # then prolong
            old_expire = shares[USER]
            if old_expire > attempted_expire:
                utils.warning(defs.Message.ATTEMP_SHORTER_DURATION_THAN_ALREADY_GRANTED)
                utils.show_expire(old_expire)
            else:
                pesisted = write_expire(lock_path, attempted_expire)
                utils.ok(defs.Message.PROLONG_OK)
                utils.show_expire(pesisted)

        # if neither s- nor x-locked, try lock
        else:
            # want shared
            if mode == "shared":
                if exclusive is None:
                    pesisted = write_expire(join(defs.SDIR, USER), attempted_expire)
                    utils.show_grant_ok(mode, USER)
                    utils.show_expire(pesisted)
                else:
                    raise utils.RuntimeErrorWithMessageAndCode(
                        defs.Message.GRANT_FAILURE_MSG,
                        defs.Message.GRANT_FAILURE_CODE,
                    )
            # want exclusive
            else:
                if len(shares) == 0 and exclusive is None:
                    pesisted = write_expire(join(defs.XDIR, USER), attempted_expire)
                    utils.show_grant_ok(mode, USER)
                    utils.show_expire(pesisted)
                else:
                    raise utils.RuntimeErrorWithMessageAndCode(
                        defs.Message.GRANT_FAILURE_MSG,
                        defs.Message.GRANT_FAILURE_CODE,
                    )


def check_env():
    if not isdir(defs.DATA_DIR) or not isdir(defs.SDIR) or not isdir(defs.XDIR):
        raise utils.RuntimeErrorWithMessageAndCode(
            defs.DIR_ERROR_MSG, defs.DIR_ERROR_CODE
        )


def main():
    parser = argparse.ArgumentParser(
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description=(defs.Message.PROG_HELP),
    )
    parser.add_argument("-s", "--status", action="store_true")
    parser.add_argument("-m", "--mode", choices=["exclusive", "shared"])
    parser.add_argument(
        "-d", "--duration", default="30m", help=defs.Message.DURATION_HELP
    )
    parser.add_argument("-r", "--revoke", action="store_true")
    parser.add_argument("-u", "--USER", default=USER, help=defs.Message.USER_HELP)
    args = parser.parse_args()

    try:
        check_env()

        if args.status:
            print_status()
        elif args.revoke:
            revoke(args.USER)
        elif args.mode is not None:
            grant(args.mode, args.duration)
        else:
            parser.print_help()
    except utils.RuntimeErrorWithMessageAndCode as err:
        utils.error(err.msg)
        sys.exit(err.code)
    except Exception as err:
        utils.error("Unexpected error: {err}".format(err=err))
        print_tb(err.__traceback__)
        sys.exit(defs.Message.UNEXPECTED_ERROR_CODE)


if __name__ == "__main__":
    main()
    sys.exit(0)  # is this necessary?
